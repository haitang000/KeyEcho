<Window x:Class="KeyEcho.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyEcho · 键鼠音效" Width="830" Height="740" MinWidth="730" MinHeight="590" WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Icon="Assets/KeyEcho.ico">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E5EAF0" BorderThickness="0,0,0,1" Padding="28,22">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Background="#1769D2" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0"><TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="KeyEcho" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="让每一次敲击，都有回响。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
        <ToggleButton x:Name="EnableToggle" Grid.Column="2" IsChecked="{Binding Enabled}" AutomationProperties.Name="启用键鼠音效" Padding="16,8" MinWidth="94" VerticalAlignment="Center" IsEnabled="{Binding Ready}">
          <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="已暂停" /><Setter Property="Cursor" Value="Hand" /><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="已开启" /><Setter Property="Background" Value="#E5F4ED" /><Setter Property="Foreground" Value="#146B45" /></Trigger></Style.Triggers></Style></ToggleButton.Style>
        </ToggleButton>
      </Grid>
    </Border>
      <Grid Grid.Row="1" Margin="28,24,28,18" IsEnabled="{Binding Ready}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="228" /></Grid.ColumnDefinitions>
        <TabControl SelectedIndex="{Binding ActiveInputTab}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="键盘与鼠标音效">
        <TabItem Header="键盘音效"><ScrollViewer x:Name="KeyboardSoundsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0"><StackPanel>
          <TextBlock Text="选择你的声音" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="在任意应用中，按下一次，响一次。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18" />
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding MechanicalSelected}" AutomationProperties.Name="机械键盘">
            <StackPanel><TextBlock Text="机械键盘" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="9 款真实录音 · 空格、回车独立声音" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <ComboBox ItemsSource="{Binding KeyboardPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedKeyboardPreset}" Margin="0,0,0,12" MinHeight="38" Padding="10,7" HorizontalContentAlignment="Left" AutomationProperties.Name="键盘轴体与键帽" ToolTip="切换轴体后可点击右侧试听，也可以直接打字感受" />
          <TextBlock Text="热门梗音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,2,0,10" />
          <UniformGrid Columns="2">
          <RadioButton Style="{StaticResource SoundCard}" Margin="0,0,10,0" GroupName="Sound" IsChecked="{Binding FahSelected}" AutomationProperties.Name="FAHHHHHH">
            <StackPanel><TextBlock Text="FAHHHHHH" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="经典喊声" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding BingSelected}" AutomationProperties.Name="冰冰冰">
            <StackPanel><TextBlock Text="冰冰冰" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="原声短音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" Margin="0,0,10,0" GroupName="Sound" IsChecked="{Binding BruhSelected}" AutomationProperties.Name="bruh">
            <StackPanel><TextBlock Text="bruh" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="原声短音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding AughSelected}" AutomationProperties.Name="AUGHHHHH">
            <StackPanel><TextBlock Text="AUGHHHHH" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="原声梗音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" Margin="0,0,10,0" GroupName="Sound" IsChecked="{Binding MetalPipeSelected}" AutomationProperties.Name="钢管落地">
            <StackPanel><TextBlock Text="钢管落地" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="金属碰撞声" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding ShockedSelected}" AutomationProperties.Name="Shocked">
            <StackPanel><TextBlock Text="Shocked" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="原声短音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" Margin="0,0,10,0" GroupName="Sound" IsChecked="{Binding PrivateLaughSelected}" AutomationProperties.Name="私人笑声">
            <StackPanel><TextBlock Text="私人笑声" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="原声笑声音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding WowSelected}" AutomationProperties.Name="wow">
            <StackPanel><TextBlock Text="wow" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="原声梗音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          </UniformGrid>
          <TextBlock Text="枪械音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,2,0,10" />
          <UniformGrid Columns="2">
          <RadioButton Style="{StaticResource SoundCard}" Margin="0,0,10,0" GroupName="Sound" IsChecked="{Binding PistolSelected}" AutomationProperties.Name="手枪">
            <StackPanel><TextBlock Text="手枪" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="干脆单发" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding RifleSelected}" AutomationProperties.Name="步枪">
            <StackPanel><TextBlock Text="步枪" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="厚实有力" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" Margin="0,0,10,0" GroupName="Sound" IsChecked="{Binding ShotgunSelected}" AutomationProperties.Name="霰弹枪">
            <StackPanel><TextBlock Text="霰弹枪" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="低沉冲击" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding AwmSelected}" AutomationProperties.Name="AWM 狙击枪">
            <StackPanel><TextBlock Text="AWM 狙击枪" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="重狙风格 · 长尾响" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          </UniformGrid>
          <RadioButton Style="{StaticResource SoundCard}" GroupName="Sound" IsChecked="{Binding CustomSelected}" Visibility="{Binding HasCustom, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="自定义音效">
            <StackPanel><TextBlock Text="自定义音效" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding CustomName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
          </RadioButton>
          <Button Content="＋ 导入 WAV 音效" Click="Import_Click" HorizontalAlignment="Stretch" Margin="0,3,0,0" AutomationProperties.Name="导入 WAV 音效" />
          <TextBlock Text="单／双声道 WAV · 最长 30 秒 · 最大 32 MB" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="鼠标音效"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,18,8,0"><StackPanel>
          <TextBlock Text="为每一次点击配上声音" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Text="选择真实点击声，或跟随当前键盘、枪械与梗音效。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20" />
          <Border Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel>
              <CheckBox Content="启用鼠标点击音效" IsChecked="{Binding MouseEnabled}" FontWeight="SemiBold" AutomationProperties.Name="启用鼠标点击音效" />
              <TextBlock Text="音效类型" FontWeight="SemiBold" Margin="0,24,0,10" />
              <ComboBox ItemsSource="{Binding MousePresets}" SelectedItem="{Binding SelectedMousePreset}" DisplayMemberPath="Name" MinHeight="40" Padding="10,7" AutomationProperties.Name="鼠标音效类型" />
              <TextBlock Text="{Binding SelectedMousePreset.Description}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="支持左键、右键、中键和前进／后退侧键。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,20,0,8" />
          <TextBlock Text="按下发声，长按不重复；移动和滚轮不播放。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,20" />
          <Border Background="#EAF2FE" CornerRadius="8" Padding="16"><TextBlock Text="鼠标音量可在右侧独立调节。Ctrl + Alt + F12 会同时暂停或恢复键盘与鼠标音效。" Foreground="#315A89" FontSize="12" TextWrapping="Wrap" /></Border>
        </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Border Background="White" CornerRadius="12" BorderBrush="#E1E7EF" BorderThickness="1" Padding="20">
            <StackPanel>
              <Border Background="#EFF5FD" CornerRadius="12" Width="60" Height="60" HorizontalAlignment="Left"><TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="29" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
              <TextBlock Text="当前音效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,6" />
              <TextBlock Text="{Binding ActiveSoundName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding ActiveSoundName}" />
              <TextBlock Text="{Binding ActiveSoundDescription}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
              <Button Content="▶  试听声音" Click="Preview_Click" Margin="0,18,0,24" HorizontalAlignment="Stretch" AutomationProperties.Name="试听声音" />
              <Grid><TextBlock Text="音量" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveVolume, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" /></Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding ActiveVolume, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,2" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" AutomationProperties.Name="当前设备音量" />
              <TextBlock Text="{Binding ActiveVolumeLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <CheckBox Content="登录 Windows 时启动" IsChecked="{Binding StartOnLogin}" Margin="3,20,0,15" AutomationProperties.Name="登录 Windows 时启动" />
          <Border Background="#EBEFF5" Height="1" />
          <TextBlock Text="Ctrl + Alt + F12" FontFamily="Consolas" FontSize="13" Margin="2,17,0,7" />
          <TextBlock Text="随时暂停或恢复音效" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0" />
        </StackPanel></ScrollViewer>
      </Grid>
    <StackPanel Grid.Row="2">
      <Border Background="#FFF5D8" Padding="16,10" Margin="28,0,28,12" CornerRadius="6" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1" Content="×" Click="Dismiss_Click" Padding="8,0" Margin="8,0,0,0" MinHeight="24" AutomationProperties.Name="关闭提示" /></Grid>
      </Border>
      <Border BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="28,13" Background="White">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding AudioStatus}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,10,0" /></StackPanel>
          <Button Grid.Column="1" Content="关于与音效来源" Click="About_Click" Padding="8,3" MinHeight="28" VerticalAlignment="Center" FontSize="11" />
        </Grid>
      </Border>
    </StackPanel>
  </Grid>
</Window>
